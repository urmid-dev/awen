# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Chat model used for Jo's replies, hints and feedback
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text model
GROQ_STT_MODEL=whisper-large-v3-turbo
PORT=3000
# Set to 1 to run without a key using canned replies (UI testing only)
GROQ_MOCK=0
# Backup model, used when the main model's per-minute limit is reached
GROQ_BACKUP_MODEL=openai/gpt-oss-20b
